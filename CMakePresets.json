{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2026-windows-vcpkg",
      "displayName": "Visual Studio 2026 - SE, AE and VR in one DLL",
      "generator": "Visual Studio 18 2026",
      "toolset": "v145",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "COMMONLIB_PREBUILT": "OFF"
      },
      "errors": { "deprecated": true },
      "warnings": { "deprecated": true, "dev": true }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2026-windows-vcpkg", "configuration": "Release" },
    { "name": "debug", "configurePreset": "vs2026-windows-vcpkg", "configuration": "Debug" }
  ]
}
